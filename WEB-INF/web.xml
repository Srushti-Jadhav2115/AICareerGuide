<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>Career Guide</display-name>

    <!--
        All six servlets (SignupServlet, LoginServlet, CareerServlet,
        FeedbackServlet, AssessmentSubmitServlet, AssessmentResultServlet)
        are registered via @WebServlet annotations in src/com/career and
        are intentionally NOT re-declared here. Declaring the same class
        again under a differently-implied servlet-name would create a
        second, conflicting mapping to the same URL pattern.
    -->

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- Never show a raw stack trace to a student — Phase "Error Handling" requirement. -->
    <error-page>
        <error-code>404</error-code>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Exception</exception-type>
        <location>/error.jsp</location>
    </error-page>

</web-app>
